<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LSPosed 模块本身不需要蓝牙权限：Hook 运行在宿主进程内，用的是宿主自己的权限。 -->

    <!-- WRITE_SECURE_SETTINGS：用于「信息页的开关」写入 Settings.Global。
         需要一次性授权；未授权时开关只读（页面会给出授权命令）。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:description="@string/app_desc"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- 信息页。注意：桌面入口不放在这里，而由下面的 activity-alias 承载，
             这样「隐藏桌面图标」只需禁用 alias，本 Activity 依然可被
             LSPosed Manager / adb 启动。 -->
        <activity
            android:name="io.github.nhckmelody.SettingsActivity"
            android:exported="true" />

        <!-- 桌面入口（可被本 App 自行禁用，实现"隐藏桌面图标"） -->
        <activity-alias
            android:name="io.github.nhckmelody.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity="io.github.nhckmelody.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ★ 「隐藏桌面图标」后仍能被 LSPosed Manager 打开的关键。
             android.content.pm.PackageManager#getLaunchIntentForPackage 的查找顺序是：
                 ① ACTION_MAIN + CATEGORY_INFO        ← 先找这个
                 ② ACTION_MAIN + CATEGORY_LAUNCHER    ← 找不到才用这个
             LSPosed Manager（以及不少启动器/工具）就是用它来"打开模块"的。
             所以一旦把上面那个带 LAUNCHER 的别名禁用掉，两者都落空 → 模块打不开。

             这里提供一个【常驻启用】的 CATEGORY_INFO 别名：
               · 它**不会**出现在桌面（launcher 只收录 CATEGORY_LAUNCHER）
               · 却能让 getLaunchIntentForPackage 命中，从而 LSPosed 依然能打开本页
             因此这个别名**任何情况下都不要禁用**。 -->
        <activity-alias
            android:name="io.github.nhckmelody.InfoAlias"
            android:enabled="true"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity="io.github.nhckmelody.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
                <!-- CATEGORY_DEFAULT：让带 MATCH_DEFAULT_ONLY 的查询（如 am start 隐式意图、
                     部分工具/ROM）也能解析到，提升兼容性。
                     它**不会**让本别名出现在桌面 —— launcher 只收录 CATEGORY_LAUNCHER。 -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
